{
  "name": "riftor",
  "version": "5.0.0-alpha.0",
  "description": "Pi-powered cybersecurity assessment harness",
  "author": "amanverasia",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanverasia/riftor.git"
  },
  "homepage": "https://riftor.dev",
  "bugs": {
    "url": "https://github.com/amanverasia/riftor/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "riftor": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cybersecurity",
    "security-assessment",
    "pentest"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "typebox": "1.3.34"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/cli.js"
  }
}
